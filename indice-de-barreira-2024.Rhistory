# ==============================================================================
# SCRIPT: ANÁLISE ESPACIAL E CÁLCULO DO ÍNDICE DE BARREIRA (RJ)
# ==============================================================================

# 1. INSTALAÇÃO E CARREGAMENTO DE PACOTES --------------------------------------
# (Descomente as linhas abaixo caso precise reinstalar algum pacote)
# install.packages(c("sf", "spdep", "dplyr", "tmap", "readr", "tidyverse"))

library(sf)          # Manipulação de dados vetoriais (Shapefiles)
library(dplyr)       # Manipulação e junção de tabelas (Dataframes)
library(tmap)        # Criação de mapas temáticos e interativos
library(readr)       # Leitura otimizada de arquivos CSV

# 2. CONFIGURAÇÃO DO AMBIENTE E IMPORTAÇÃO DE DADOS ----------------------------

# Define o diretório de trabalho principal
setwd("C:/Cartografia e Saude")

# Importa o shapefile dos municípios do Rio de Janeiro (Ano 2024)
muni <- st_read("C:/Users/joyce/Downloads/RJ_Municipios_2024 (2)/RJ_Municipios_2024.shp")

# Importa a tabela com as variáveis do índice de barreira de 2014
dados <- read_csv("C:/Cartografia e Saude/indice_barreira_2014.csv")

# [Opcional] Verificação rápida das colunas importadas
# names(muni)
# names(dados)

# 3. JUNÇÃO DOS DADOS (SPATIAL JOIN) -------------------------------------------

# Une a malha geográfica com a tabela de dados usando o código do município
# Ajuste "codigo" ou "municipios" na chave correspondente à sua tabela real
mapa_dados <- muni %>%
  left_join(dados, by = c("CD_MUN" = "codigo"))

# 4. PROCESSAMENTO E CÁLCULO DO ÍNDICE -----------------------------------------

# Função para normalizar os dados por Min-Max (escala entre 0 e 1)
# Remove valores ausentes (NA) para evitar que o cálculo falhe
normalize <- function(x) {
  (x - min(x, na.rm = TRUE)) / (max(x, na.rm = TRUE) - min(x, na.rm = TRUE))
}

# Calcula o Índice de Barreira somando a Frequência Relativa (FR) 
# e a Densidade Demográfica (densipop), ambas previamente normalizadas
mapa_dados$indice_barreira <- normalize(mapa_dados$FR) + normalize(mapa_dados$densipop)

# Criação de uma variável categórica para o índice (caso queira legenda discreta)
# Exemplo de categorização em 3 classes (Baixo, Médio, Alto) usando quantis
mapa_dados$barreira_cat <- cut(mapa_dados$indice_barreira, 
                               breaks = quantile(mapa_dados$indice_barreira, probs = c(0, 0.33, 0.66, 1), na.rm = TRUE),
                               labels = c("Baixo", "Médio", "Alto"),
                               include.lowest = TRUE)

# 5. VISUALIZAÇÃO INTERATIVA (MODO VIEW) ---------------------------------------

# Altera o modo do tmap para visualização interativa (webmap)
tmap_mode("view")

# Gera o mapa dinâmico para análise em tela
tm_shape(mapa_dados) +
  tm_polygons("indice_barreira",
              palette = "YlOrRd",
              title = "Índice de Barreira - 2014",
              style = "quantile") +
  tm_layout(title = "Mapa de Índice de Barreira - RJ (2014)",
            legend.outside = TRUE)

# 6. VISUALIZAÇÃO ESTÁTICA PARA PUBLICAÇÃO (MODO PLOT) -------------------------

# Retorna para o modo estático (ideal para gerar imagens de relatórios/artigos)
tmap_mode("plot")

# Estrutura o layout final do mapa estático com paleta Divergente (Red/Blue)
mapa_final <- tm_shape(mapa_dados) +
  tm_polygons("barreira_cat",
              palette = c("blue", "grey", "red"), # Customizado: Azul (Baixo) -> Vermelho (Alto)
              title = "Índice de Barreira") +
  tm_layout(
    legend.position = c("right", "center"),
    legend.bg.color = "white",
    legend.frame = TRUE,
    legend.text.size = 0.6,
    legend.title.size = 0.8,
    inner.margins = c(0.05, 0.2, 0.05, 0.05) # Ajusta margens internas para não cortar a legenda
  )

# Exibe o mapa final no painel do RStudio
mapa_final

# 7. EXPORTAÇÃO DO MAPA --------------------------------------------------------

# Salva o mapa final em formato JPEG com alta resolução (300 DPI) para impressão
tmap_save(mapa_final,
          filename = "mapa_barreira.jpeg",
          width = 20, 
          height = 15, 
          units = "cm", 
          dpi = 300)